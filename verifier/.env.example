# Copy to .env and fill in. Real .env is git-ignored.
# Run the verifier from a machine on the WireGuard VPN.

# WAF NodePort on the app VM (private IP, over the VPN)
WAF_URL=http://10.20.1.253:30443

# Wazuh indexer (private IP, over the VPN)
INDEXER_URL=https://10.20.1.118:9200
INDEXER_USER=admin
INDEXER_PASSWORD=CHANGE_ME

# Optional tuning
READINESS_TIMEOUT=120
DELIVERY_TIMEOUT=120
POLL_INTERVAL=5
